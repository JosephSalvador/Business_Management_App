<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Application\BusinessOS.Application.csproj" />
    <ProjectReference Include="..\Domain\BusinessOS.Domain.csproj" />
    <ProjectReference Include="..\Shared\BusinessOS.Shared.csproj" />
    <ProjectReference Include="..\Notifications\BusinessOS.Notifications.csproj" />
    <ProjectReference Include="..\Modules\Sales\BusinessOS.Modules.Sales.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.Core" Version="3.7.400.5" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.400.5" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Fluid.Core" Version="2.19.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Exposes the TOTP primitives (base32, single-step code generation) to the test project.
      They are internal because nothing outside this assembly should be deriving codes, but
      the test vectors in RFC 6238 can only be verified against them directly.
    -->
    <InternalsVisibleTo Include="BusinessOS.Tests" />
  </ItemGroup>

</Project>
