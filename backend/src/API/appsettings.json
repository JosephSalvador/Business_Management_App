{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "businessos",
    "Audience": "businessos-clients",
    "AccessTokenMinutes": 15
  },
  "Security": {
    "MaxFailedLoginAttempts": 5,
    "LockoutDurationMinutes": 15,
    "TwoFactorRequiredForOwners": true,
    "TwoFactorEncryptionKey": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "AuthWindowSeconds": 60,
    "AuthPermitLimit": 10,
    "GlobalPermitLimit": 200,
    "GlobalWindowSeconds": 60
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "",
    "InstanceName": "businessos:"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "From": "",
    "FromName": "Business OS",
    "UseStartTls": true
  },
  "Sms": {
    "Provider": "Logging",
    "ApiKey": "",
    "SenderId": "BusinessOS"
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "storage",
    "PublicBaseUrl": "",
    "Endpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "",
    "Region": "",
    "UseHttps": false
  },
  "Payments": {
    "Provider": "Logging",
    "ApiKey": "",
    "WebhookSecret": "",
    "Currency": "TZS"
  }
}
